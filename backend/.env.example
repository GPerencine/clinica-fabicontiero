# Variáveis de ambiente do BACKEND — Clínica Fabi Contiero
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env com valores reais no repositório.

# Porta do servidor
PORT=3002

# String de conexão com o MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<senha>@cluster.mongodb.net/<banco>?retryWrites=true&w=majority

# Chave secreta para assinar tokens JWT
# Gere uma chave forte com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_FORTE_DE_64_BYTES

# Usuário administrador
ADMIN_USER=fabi

# Senha do administrador (usada APENAS com seedAdmin.js para setup inicial)
# Nunca defina esta variável em produção permanentemente — só durante o seed.
ADMIN_PASS=SUBSTITUA_PELA_SENHA_DESEJADA

# URL base do servidor (usada nas URLs de imagens)
# Desenvolvimento: http://localhost:3002
# Produção: https://seudominio.com.br
BASE_URL=http://localhost:3002

# Ambiente (development | production | test)
NODE_ENV=development
